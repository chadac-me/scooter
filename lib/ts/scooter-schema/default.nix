{ lib, buildNpmPackage, nodejs, ... }:

# The generated Drizzle schema package (@scooter/schema): the shared table
# definitions and ownership guard from lib/sql, built as its own npm package that
# consumers symlink into node_modules. The src/<db>.ts modules are generated by
# `just db-generate`, and CI fails on drift.

buildNpmPackage {
  pname = "scooter-schema-js";
  version = "0.0.0";
  src = (import ../../../nix/package-source.nix { inherit lib; }).of ./.;

  npmDepsHash = "sha256-BA9sMAPR9jwYzdQ4vheK7a7ovwRTWmFNF2/C7+XnJOA=";

  # A custom installPhase bypasses the dev-prune hook, so prune explicitly down to
  # drizzle-orm, drop its optional pglite peer, and sweep the empty scope dirs.
  installPhase = ''
    runHook preInstall
    npm prune --omit=dev --offline
    rm -rf node_modules/@electric-sql
    find node_modules -type d -empty -delete
    mkdir -p $out/lib/node_modules/@scooter/schema
    cp -r dist package.json node_modules $out/lib/node_modules/@scooter/schema/
    runHook postInstall
  '';

  meta.description = "@scooter/schema — generated Drizzle schema (isolated)";
}
